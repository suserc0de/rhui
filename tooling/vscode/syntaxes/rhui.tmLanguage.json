{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RHUI",
  "scopeName": "text.html.rhui",
  "patterns": [
    {
      "include": "#interpolation"
    },
    {
      "include": "#dynamic-attribute"
    },
    {
      "include": "#component-tag"
    },
    {
      "include": "#control-tag"
    },
    {
      "include": "#slot-tag"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "interpolation": {
      "name": "meta.interpolation.rhui",
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.rhui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.rhui" }
      },
      "patterns": [
        {
          "name": "keyword.operator.pipe.rhui",
          "match": "\\|"
        },
        {
          "name": "support.function.filter.rhui",
          "match": "\\|\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "string.quoted.double.rhui",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.rhui",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "constant.numeric.rhui",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.language.boolean.rhui",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.other.rhui",
          "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "dynamic-attribute": {
      "name": "meta.attribute.dynamic.rhui",
      "match": "(:[a-zA-Z0-9_-]+)(?:(=)(\"([^\"]*)\"|'([^']*)'))?",
      "captures": {
        "1": { "name": "entity.other.attribute-name.dynamic.rhui" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "string.quoted.rhui" }
      }
    },
    "component-tag": {
      "name": "meta.tag.component.rhui",
      "match": "(<\\/?)(ui:[a-zA-Z0-9_-]+|[A-Z][a-zA-Z0-9_]+)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.rhui" },
        "2": { "name": "entity.name.tag.component.rhui" }
      }
    },
    "control-tag": {
      "name": "meta.tag.control.rhui",
      "match": "(<\\/?)(if|else|each|component|props|prop)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.rhui" },
        "2": { "name": "keyword.control.rhui" }
      }
    },
    "slot-tag": {
      "name": "meta.tag.slot.rhui",
      "match": "(<\\/?)(slot(?::[a-zA-Z0-9_-]+)?)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.rhui" },
        "2": { "name": "support.function.slot.rhui" }
      }
    }
  }
}
