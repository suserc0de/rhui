{
  "name": "rhui-vscode",
  "displayName": "RHUI Template Syntax",
  "description": "Syntax highlighting, snippets, and language support for RHUI (.rhui) component template files.",
  "version": "1.0.5",
  "publisher": "coderhaqi",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rhui",
        "aliases": [
          "RHUI",
          "rhui"
        ],
        "extensions": [
          ".rhui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rhui",
        "scopeName": "text.html.rhui",
        "path": "./syntaxes/rhui.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rhui",
        "path": "./snippets/rhui.json"
      }
    ]
  }
}
